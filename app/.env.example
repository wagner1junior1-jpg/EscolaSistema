# Origem dos dados: mock | supabase (supabase ainda NÃO implementado: usar mock)
VITE_DATA_SOURCE=mock

# Supabase Configuration (URL base sem /rest/v1/)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Endereço (slug) da Edge Function de usuários. O painel do Supabase pode gerar um apelido
# diferente do nome (ex.: swift-processor): use o que aparece em Edge Functions > URL.
# Sem esta variável, o app chama "admin-usuarios".
# VITE_FN_ADMIN_USUARIOS=admin-usuarios

# Ambiente de teste: faixa, atalhos de login demo e restaurar dados. Em produção: false
VITE_MODO_TESTE=true
