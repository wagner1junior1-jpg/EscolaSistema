# Origem dos dados: mock | supabase (supabase ainda NÃO implementado: usar mock)
VITE_DATA_SOURCE=mock

# Supabase Configuration (URL base sem /rest/v1/)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Endereço (slug) da Edge Function de usuários. O painel do Supabase pode gerar um apelido
# diferente do nome (ex.: swift-processor): use o que aparece em Edge Functions > URL.
# Sem esta variável, o app chama "admin-usuarios".
# VITE_FN_ADMIN_USUARIOS=admin-usuarios
# Idem para a Edge Function de IA (sem a variável, o app chama "gerar-questoes").
# VITE_FN_GERAR_QUESTOES=gerar-questoes

# A chave do Gemini NÃO fica aqui: variáveis VITE_* vão para o bundle público. Com Supabase ela é
# o segredo GEMINI_API_KEY da Edge Function (painel > Edge Functions > Secrets). No modo mock a
# demonstração com IA real usa a chave colada na tela "Gerar com IA" (fica só neste navegador).

# Ambiente de teste: faixa, atalhos de login demo e restaurar dados. Em produção: false
VITE_MODO_TESTE=true
